# Copy this file to `.env` and fill in your real API keys. Never commit your real `.env`.
# Example values are placeholders only.

# Embedding provider (OpenAI) - used for FAISS index construction and semantic search
OPENAI_API_KEY=sk-REPLACE_ME_OPENAI

# Anthropic API key (if you use Claude / Anthropic models)
# NOTE: do NOT put your real key here. Copy this file to `.env` and place the real key there.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_ANTHROPIC

# LangSmith (optional) - for trace logging
LANGSMITH_API_KEY=ls-REPLACE_ME_LANGSMITH
LANGSMITH_PROJECT=arag-project

# Enable LangChain tracing if desired
LANGCHAIN_TRACING_V2=true
